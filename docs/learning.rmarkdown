##Extract ID from filepath

```{r}
hr_data |>
  mutate(
    id = str_extract(
      file_path_id,
      pattern = "/stress/[:alnum:]{2}/"
    ) |>
      str_remove("/stress/") |>
      str_remove("/"),
    .before = file_path_id
  ) |>
  select(-file_path_id)
```


##Function for particpant ID

```{r}
get_participant_id <- function(data) {
  data_with_id <- data |>
    mutate(
      id = str_extract(
        file_path_id,
        pattern = "/stress/[:alnum:]{2}/"
      ) |>
        str_remove("/stress/") |>
        str_remove("/"),
      .before = file_path_id
    ) |>
    select(-file_path_id)
  return(data_with_id)
}

# How it will be used.
get_participant_id(hr_data)
```

##Working with across

```{r}
hr_data <- read_all("HR.csv.gz") |>
  get_participant_id()

hr_data
```

```{r}
hr_data |>
  summarise(across(where(is.numeric), list(
    mean = mean,
    median = median,
    sd = sd
  )))
```

## Working with dates

```{r}
hr_data |>
  mutate(datetime = round_date(collection_datetime,
    unit = "minute"
  ))
```

## Summarising by groups


```{r}
hr_data |>
  mutate(
    collection_datetime = round_date(
      collection_datetime,
      unit = "minute"
    )
  ) |>
  summarise(
    across(
      where(is.numeric),
      list(mean = mean, sd = sd, median = median)
    ),
    .by = c(id, collection_datetime)
  )
```

