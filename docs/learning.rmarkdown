## Exercise: Create function

```{r}
#' Add two number together
#'
#' @param One number
#' @param Another number here
#'
#' @returns returns the sum of two numbers
add_numbers <- function(num1, num2) {
  added <- num1 + num2
  return(added)
}
```

## Exercise: create functions, continued

```{r}
#' Read in one nurses stress data file
#'
#' @param file_path path to a data file
#'
#' @returns outputs table with max 100 columns

read <- function(file_path) {
  data <- file_path |>
    read_csv(
      show_col_types = FALSE,
      name_repair = to_snake_case,
      n_max = 100
    )
  return(data)
}
```

## Exercise: final function

```{r}
#' Test function
#'
#' @param file_path
#' @param max_rows
#'
#' @returns your taxes, fiscal year 1987

read <- function(file_path, max_rows = 100) {
  data <- file_path |>
    readr::read_csv(
      show_col_types = FALSE,
      name_repair = to_snake_case,
      n_max = max_rows
    )
  return(data)
}

here("data-raw/nurses-stress/stress/5C/5C_1586886712/HR.csv.gz") |>
  read()

here("data-raw/nurses-stress/stress/5C/5C_1586886712/HR.csv.gz") |>
  read(max_rows = 1000)

here("data-raw/nurses-stress/stress/5C/5C_1586886712/HR.csv.gz") |>
  read(max_rows = Inf)
```

##Using map

```{r}
hr_files <- here("data-raw/nurses-stress/") |>
  dir_ls(regexp = "HR.csv.gz", recurse = TRUE)

hr_files

hr_data <- hr_files |>
  map(read) |>
  list_rbind(names_to = "file_path_id")

hr_data
```

## Exercise: Convert map to function and use on sleep.

```{r}
read_all <- function(filename) {
  files <- here::here("data-raw/nurses-stress/") |>
    fs::dir_ls(regexp = filename, recurse = TRUE)

  data <- files |>
    purrr::map(read) |>
    purrr::list_rbind(names_to = "file_path_id")

  return(data)
}

read_all("HR.csv.gz")
read_all("IBI.csv.gz")
```

## Excercise 18.6, maxrow argument in read_all function

```{r}
read_all <- function(filename, max_rows = 100) {
  files <- here::here("data-raw/nurses-stress/") |>
    fs::dir_ls(regexp = filename, recurse = TRUE)

  data <- files |>
    purrr::map(\(file) read(file, max_rows = max_rows)) |>
    purrr::list_rbind(names_to = "file_path_id")

  return(data)
}

read_all("HR.csv.gz", max_rows = 10)
read_all("HR.csv.gz", max_rows = 1000)
```

## Excercise 18.7 Extra stuff

```{r}
.DATASET_DIR <- here::here("data-raw/nurses-stress/") # 1

# In the function body of `read_all()`.
read_all <- function(filename, max_rows = 100) {
  files <- .DATASET_DIR |> # 2
    fs::dir_ls(regexp = filename, recurse = TRUE)

  data <- files |>
    purrr::map(\(file) read(file, max_rows = max_rows)) |>
    purrr::list_rbind(names_to = "file_path_id")

  return(data)
}

read_all("HR.csv.gz", max_rows = 10)
read_all("HR.csv.gz", max_rows = 1000)
```

